# From @BotFather
TELEGRAM_BOT_TOKEN=

# Supabase project settings -> API
SUPABASE_URL=
# service_role key, NOT anon. This backend bypasses RLS by design;
# RLS stays enabled on every table to lock out every other access path.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed to run database migrations (npm run migrate), not to run the bot.
# Supabase project settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Reused from the Week 0 OCR test
GEMINI_API_KEY=

# Optional overrides - safe to leave unset, sensible defaults apply.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
# GEMINI_JUDGE_MODEL=gemini-3.7-flash
# TRANSCRIPT_CONFIDENCE_THRESHOLD=0.6
# PORT=3000
