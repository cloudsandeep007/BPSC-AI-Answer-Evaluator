{
  "name": "bpsc-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:polling": "tsx watch src/dev-polling.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "set-webhook": "tsx src/scripts/set-webhook.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "verify:calibration": "tsx scripts/verify-calibration.ts",
    "ingest:content": "tsx scripts/ingest-content.ts",
    "smoke:stages": "tsx scripts/smoke-stages.ts",
    "preview:report-card": "tsx scripts/preview-report-card.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^6.3.4",
    "dotenv": "^16.4.0",
    "grammy": "^1.30.0",
    "ioredis": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^1.6.0"
  }
}
